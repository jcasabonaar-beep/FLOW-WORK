{
  "mcpServers": {
    "playwright": {
      "command": "node",
      "args": [
        "node_modules/@playwright/mcp/cli.js",
        "--cdp-endpoint", "http://127.0.0.1:9222",
        "--output-dir", "tools/pw-output",
        "--allow-unrestricted-file-access",
        "--timeout-action", "20000"
      ]
    }
  }
}
